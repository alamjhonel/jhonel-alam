# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Editor / OS
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.cache/

# Vite cache
.vite/
*.tsbuildinfo

# Optional: lockfile-less local npm cache
.npm/
.yarn/
.pnpm-store/

# Cert PDFs are inlined as base64 data URIs into the JS bundle at build
# time (see vite-plugins/cert-assets.js), so they must be tracked for
# Vercel builds to include them.

# Debug / local tooling artifacts
.dbg/
.vercel/
debug-*.md
